{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prediction: verdict and references to paper block IDs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instance_id",
    "verdict",
    "confidence",
    "predicted_eids",
    "issue_tags",
    "rationale_short"
  ],
  "properties": {
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "type": "string",
      "enum": [
        "warranted",
        "overclaimed",
        "contradicted",
        "insufficient"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "predicted_eids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "issue_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "numerical_inconsistency",
          "unsupported_generalization",
          "evidence_missing_or_incomplete",
          "comparison_not_supported",
          "mismatched_experimental_conditions",
          "other"
        ]
      }
    },
    "rationale_short": {
      "type": "string",
      "minLength": 1
    }
  }
}
