{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scientific paper represented as ordered blocks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paper_id",
    "title",
    "blocks"
  ],
  "properties": {
    "paper_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        },
        "doi": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "year": {
          "type": "integer",
          "minimum": 1800
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bid",
          "kind",
          "text"
        ],
        "properties": {
          "bid": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "table",
              "caption",
              "heading",
              "other"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string"
          },
          "page": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "label": {
            "type": "string"
          }
        }
      }
    }
  }
}
